          "__rl": true,
          "mode": "list",
          "value": "",
          "cachedResultName": "Select cold-chain incident channel"
        },
        "text": "=:rotating_light: *COLD CHAIN INCIDENT* :rotating_light:\n*Batch:* {{ $json.body.batch_id }} ({{ $json.body.produce }})\n*Device:* {{ $json.body.device_id }}\n*Temperature:* {{ $json.body.temperature }}°C\n*Humidity:* {{ $json.body.humidity }}%\n*Est. shelf life:* {{ $json.body.shelf_life_hours }}h\n*Location:* {{ $json.body.latitude }}, {{ $json.body.longitude }}\nAutomated markdown discount applied to clear stock.",
